{
  "name": "harbor-db",
  "version": "0.1.8",
  "description": "A local desktop database workbench with SQL, document, key-value, graph and vector workflows",
  "homepage": "https://github.com/aligeek-tech/harbor-db",
  "repository": {
    "type": "git",
    "url": "https://github.com/aligeek-tech/harbor-db.git"
  },
  "author": "Harbor DB contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/linux-sandbox.mjs check",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "HARBOR_INTEGRATION=1 vitest run tests/",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.ts *.json",
    "db:up": "docker compose up -d --wait",
    "db:seed": "node scripts/seed.mjs",
    "db:down": "docker compose down",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "start": "electron .",
    "prestart": "node scripts/linux-sandbox.mjs check",
    "setup:linux": "node scripts/linux-sandbox.mjs setup",
    "postinstall": "install-electron",
    "benchmark": "HARBOR_BENCHMARK=1 vitest run tests/benchmark.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "3.1135.0",
    "@aws-sdk/client-dynamodb": "3.1135.0",
    "@clickhouse/client": "1.23.1",
    "@duckdb/node-api": "1.5.5-r.5",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@smithy/node-http-handler": "4.12.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "cassandra-driver": "4.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hdb": "2.29.6",
    "lossless-json": "4.3.1",
    "lucide-react": "1.46.0",
    "mariadb": "3.5.4",
    "monaco-editor": "0.56.0",
    "mongodb": "7.6.0",
    "neo4j-driver": "6.2.0",
    "node-firebird-driver": "3.7.1",
    "node-firebird-driver-wire": "0.0.1-beta.4",
    "oracledb": "7.0.1",
    "pg": "8.23.0",
    "pg-cursor": "2.22.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.2.1",
    "sonner": "2.0.7",
    "sql-formatter": "15.8.2",
    "ssh2": "1.17.0",
    "tailwind-merge": "3.3.1",
    "tedious": "20.0.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/oracledb": "7.0.3",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.15",
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "ibm_db": "4.0.1"
  },
  "peerDependenciesMeta": {
    "ibm_db": {
      "optional": true
    }
  }
}
